# ── Database (required) ───────────────────────────────
# Neon serverless Postgres connection string.
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/versions

# ── Auth (required) ───────────────────────────────────
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=generate-a-random-32-char-string-here
NEXTAUTH_URL=http://localhost:3000

# ── Arc L1 settlement ─────────────────────────────────
# NETWORK: currently Arc TESTNET. Arc MAINNET launches 2026-09-16 — swap
# ARC_RPC_URL / ARC_USDC_CONTRACT to mainnet values then (see README).
# Omit both to run the Arc adapter in mock mode (deterministic hashes, no on-chain calls).
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_USDC_CONTRACT=0x3600000000000000000000000000000000000000
# ERC-8183 Agentic Commerce (license = job). Defaults to Arc testnet reference.
ARC_ERC8183_CONTRACT=0x0747EEf0706327138c69792bF28Cd525089e4583
# ERC-8004 Identity Registry (agent identity). Defaults to Arc testnet reference.
ARC_ERC8004_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
NEXT_PUBLIC_ARC_ERC8183_CONTRACT=0x0747EEf0706327138c69792bF28Cd525089e4583
# Wallet that receives the platform share of each settlement leg.
PLATFORM_WALLET=
# Optional: server-side signer for automated settlement. When set, the
# settlement service will sign and broadcast real ERC-20 transfers from
# PLATFORM_WALLET. SECURITY: this is a hot wallet; use a dedicated treasury
# key and rotate/restrict it after the hackathon/demo.
PLATFORM_WALLET_PRIVATE_KEY=

# ── Inference (OpenRouter — free tier) ─────────────────
# One key enables live LLM + text embeddings. Get a key at https://openrouter.ai/keys
# Omit to run mock mode (deterministic reviews + hash embeddings).
OPENROUTER_API_KEY=
# Optional overrides (defaults shown):
# LLM_MODEL=openai/gpt-oss-20b:free
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=VERSIONS

# ── LLM (custom provider — overrides OpenRouter when LLM_API_KEY is set) ─
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── CLAP audio embeddings (custom — overrides OpenRouter when set) ───────
# Hosted CLAP service for audio-native vectors. When unset, OpenRouter
# embeds catalog text (title + placement brief) instead of raw audio.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=clap-default
EMBEDDING_DIMENSIONS=512

# ── Agent + A&R wallets ───────────────────────────────
# Preferred: set AGENT_KEY_SEED to give every agent its own deterministic
# testnet wallet (privkey = sha256(seed:label)) that genuinely signs its
# USDC transfers on Arc. TESTNET ONLY — anyone with the seed can recompute
# every agent key.
AGENT_KEY_SEED=
# Optional explicit overrides (take precedence over seed-derived addresses).
# Omit everything to use deterministic placeholder addresses (stable across
# restarts; transfers from them settle as flagged mocks).
AGENT_WALLET_PRODUCTION=
AGENT_WALLET_PERFORMANCE=
AGENT_WALLET_MARKET=
AR_WALLET=

# ── IPFS / Pinata ─────────────────────────────────────
# Pinata JWT auth. Omit to skip IPFS pinning (uploads stay local only).
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# ── Client-side (NEXT_PUBLIC_*, inlined at build time) ─
# WalletConnect project ID — https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=
# Client-side Arc RPC fallback (defaults to ARC_RPC_URL server-side).
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
# Explorer base for tx/address links shown in the UI (economy ticker, dashboards).
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app
# Client-side submit receipt polling timeout (ms). Default 60000.
NEXT_PUBLIC_SUBMIT_RECEIPT_TIMEOUT_MS=60000

# ── Server tunables ───────────────────────────────────
# Submit receipt polling timeout for server-side workers (sweeper). Default 60000.
SUBMIT_RECEIPT_TIMEOUT_MS=60000
# Upload storage directory. Defaults to /tmp/uploads on Vercel, ./data/uploads locally.
UPLOAD_DIR=
# Rate limiter window + per-IP audio upload cap.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUDIO_MAX=30
# HTTP body / timeout / cache tunables.
JSON_BODY_LIMIT=256kb
UPSTREAM_TIMEOUT_MS=12000
SEMANTIC_CACHE_TTL_MS=30000
AUDIO_CACHE_TTL_MS=45000
# CORS — comma-separated origins, omit to allow same-origin only.
ALLOWED_ORIGINS=
# Log level: trace|debug|info|warn|error
LOG_LEVEL=info

# ── Upstash Redis (globally-coherent rate limiting) ────
# Omit both to use the in-memory rate limiter (per-instance, not
# globally coherent across serverless deployments).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Monitoring (optional) ─────────────────────────────
SENTRY_DSN=
POSTHOG_KEY=
