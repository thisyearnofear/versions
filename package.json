{
  "name": "versions-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev .",
    "build": "next build .",
    "postbuild": "bash scripts/audit-nft-traces.sh",
    "start": "next start .",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:prod:status": "bash scripts/db-prod.sh status",
    "db:prod:backup": "bash scripts/db-prod.sh backup",
    "db:prod:restore-drill": "bash scripts/db-prod.sh restore-drill",
    "db:prod:push": "bash scripts/db-prod.sh push",
    "db:studio": "drizzle-kit studio",
    "db:purge:preview": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/purge-legacy-placement-briefs.preview.sql",
    "db:purge:apply": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/purge-legacy-placement-briefs.apply.sql",
    "db:rename-briefs": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/rename-placement-briefs-columns.sql",
    "db:pgvector": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/create-pgvector-extension.sql",
    "demo": "tsx scripts/demo.ts",
    "demo:signin": "tsx scripts/demo-signin.ts",
    "ingest:tracks": "tsx scripts/ingest-my-tracks.ts",
    "extract:features": "tsx scripts/extract-features.ts",
    "seed:authorized-demo": "tsx scripts/seed-authorized-demo.ts",
    "check:arc": "tsx scripts/check-arc-live.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "primitive:demo": "tsx scripts/primitive-demo.ts",
    "curate": "tsx scripts/curate.ts",
    "seed": "tsx scripts/seed-catalog.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run lint"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.74",
    "@circle-fin/adapter-viem-v2": "^1.15.0",
    "@circle-fin/app-kit": "^1.12.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@sentry/nextjs": "^10.70.0",
    "@tanstack/react-query": "^5.101.0",
    "@types/pg": "^8.21.0",
    "ai": "^6.0.208",
    "dompurify": "^3.4.11",
    "drizzle-orm": "1.0.0-rc.4",
    "framer-motion": "^12.40.0",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.23.0",
    "pinata": "^2.5.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.53.1",
    "wagmi": "^2.19.5",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.1",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.1",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@elevenlabs/elevenlabs-js": "^2.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
